<launch>
  <arg name="camera_name" default="camera_d435_0"/>
  <arg name="model_path" default="$(find panel_detection)/models/1013.onnx"/>
  <arg name="config_file" default="$(find panel_detection)/config/panel_detection.yaml"/>
  <arg name="node_name" default="panel_detection"/>
  <arg name="use_constraint" default="1"/>
  <arg name="use_constrain" default=""/>
  <arg name="targets_topic" default="/panel/targets"/>
  <arg name="status_topic" default="/panel/status"/>
  <arg name="distance_topic" default="/panel/distance"/>
  <arg name="knob_angle_topic" default="/panel/knob_angles"/>
  <arg name="button_topic" default="/panel/buttons"/>
  <arg name="debug_image_topic" default="/panel/debug_image"/>
  <arg name="registry_target_ids" default="[]"/>
  <arg name="class_topic_prefix" default=""/>
  <arg name="max_processing_fps" default="0"/>
  <arg name="idle_processing_fps" default="$(arg max_processing_fps)"/>
  <arg name="onnx_threads" default="8"/>
  <arg name="opencv_threads" default="0"/>
  <arg name="publish_debug_image" default="true"/>
  <arg name="activity_topic" default=""/>

  <node pkg="panel_detection"
        type="panel_detect_node.py"
        name="$(arg node_name)"
        output="screen">
    <rosparam command="load" file="$(arg config_file)"/>
    <param name="model_path" value="$(arg model_path)"/>
    <param name="max_processing_fps" value="$(arg max_processing_fps)"/>
    <param name="idle_processing_fps" value="$(arg idle_processing_fps)"/>
    <param name="onnx_threads" value="$(arg onnx_threads)"/>
    <param name="opencv_threads" value="$(arg opencv_threads)"/>
    <param name="publish_debug_image" value="$(arg publish_debug_image)"/>
    <param name="activity_topic" value="$(arg activity_topic)"/>
    <param name="color_topic" value="/$(arg camera_name)/color/image_raw"/>
    <param name="depth_topic" value="/$(arg camera_name)/aligned_depth_to_color/image_raw"/>
    <param name="camera_info_topic" value="/$(arg camera_name)/color/camera_info"/>
    <param name="camera_frame" value="$(arg camera_name)_color_optical_frame"/>
    <param name="use_constraint" type="str" value="$(arg use_constraint)"/>
    <param name="use_constrain" type="str" value="$(arg use_constrain)"/>
    <!-- Explicit topic overrides make two detector instances safe to run in
         one ROS master; defaults preserve the original single-camera API. -->
    <param name="targets_topic" value="$(arg targets_topic)"/>
    <param name="status_topic" value="$(arg status_topic)"/>
    <param name="distance_topic" value="$(arg distance_topic)"/>
    <param name="knob_angle_topic" value="$(arg knob_angle_topic)"/>
    <param name="button_topic" value="$(arg button_topic)"/>
    <param name="debug_image_topic" value="$(arg debug_image_topic)"/>
    <rosparam param="registry_target_ids" subst_value="true">
      $(arg registry_target_ids)
    </rosparam>
    <param name="class_topic_prefix" value="$(arg class_topic_prefix)"/>
  </node>
</launch>
